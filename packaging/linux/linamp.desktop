[Desktop Entry]
Type=Application
Name=LinAmp
GenericName=Audio Player
Comment=A Winamp-inspired audio player
Exec=@PREFIX@/linamp %F
Path=@PREFIX@
Icon=linamp
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/aac;audio/x-aiff;audio/midi;audio/x-mod;audio/x-xm;audio/x-s3m;audio/x-it;
StartupNotify=true
